# Local development (running Node on your machine; Postgres + Redis on localhost).
# docker compose does NOT read this file's DATABASE_URL/REDIS_URL: it sets its own.
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=certiflow
POSTGRES_DB=certiflow
DATABASE_URL=postgresql://certiflow:certiflow@localhost:5432/certiflow?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=certiflow-dev-secret-change-in-prod
LARGE_BATCH_THRESHOLD=50
DISTRICT_APPROVALS_REQUIRED=2
SLA_HOURS=48
WHATSAPP_FAILURE_RATE=0.25
WHATSAPP_AMBIGUOUS_RATE=0.1
WHATSAPP_TIMEOUT_MS=150
VERIFY_RATE_LIMIT_PER_MIN=60
# Demo-only endpoints (persona switcher, stand-in WhatsApp inbox). MUST be false in production.
DEMO_MODE=true
